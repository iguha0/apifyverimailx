{
    "actorSpecification": 1,
    "title": "Email Verifier dataset",
    "description": "One item per address verified. Flat by design so the Output table reads at a glance: safeToSend answers the question, overall groups it, and the individual checks sit alongside.",
    "fields": {
        "type": "object",
        "required": [
            "email",
            "overall",
            "result",
            "validationMode",
            "checkedAt"
        ],
        "properties": {
            "email": {
                "type": "string",
                "title": "Email"
            },
            "overall": {
                "type": "string",
                "title": "Verdict",
                "description": "valid = safe to send; invalid = will bounce; risky = disposable or role mailbox, or a catch-all address that could not be resolved; unknown = no determination; error = could not be checked",
                "enum": [
                    "valid",
                    "invalid",
                    "risky",
                    "unknown",
                    "error"
                ]
            },
            "safeToSend": {
                "type": "boolean",
                "title": "Safe to send",
                "description": "True only for a confirmed deliverable mailbox. Filter on this to get a clean sending list."
            },
            "result": {
                "type": "string",
                "title": "Raw result",
                "description": "The verification service's own verdict, passed through unchanged (valid, invalid, catch_all, disposable, role, unknown)"
            },
            "deliverabilityScore": {
                "type": [
                    "integer",
                    "null"
                ],
                "title": "Score",
                "description": "0-100"
            },
            "syntaxValid": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "Syntax"
            },
            "dnsValid": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "DNS"
            },
            "mxValid": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "MX"
            },
            "smtpValid": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "SMTP"
            },
            "catchAll": {
                "type": [
                    "boolean",
                    "null"
                ],
                "title": "Catch-all",
                "description": "True only when the address sits behind a catch-all domain AND could not be resolved individually. Catch-all mailboxes are now verified directly, so most come back as a plain valid or invalid with this false."
            },
            "roleName": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Role",
                "description": "The role this address serves (support, info, admin), or null"
            },
            "disposableProvider": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Disposable provider",
                "description": "The throwaway-mail provider behind this address, or null"
            },
            "validationMode": {
                "type": "string",
                "title": "Mode",
                "enum": [
                    "full",
                    "syntax-only"
                ]
            },
            "checkedAt": {
                "type": "string",
                "title": "Checked at"
            },
            "error": {
                "type": "string",
                "title": "Error"
            },
            "warning": {
                "type": "string",
                "title": "Warning"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Verification results",
            "transformation": {
                "fields": [
                    "email",
                    "overall",
                    "safeToSend",
                    "deliverabilityScore",
                    "result",
                    "catchAll",
                    "roleName",
                    "disposableProvider",
                    "syntaxValid",
                    "dnsValid",
                    "mxValid",
                    "smtpValid",
                    "checkedAt"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    {
                        "field": "email",
                        "label": "Email"
                    },
                    {
                        "field": "overall",
                        "label": "Verdict"
                    },
                    {
                        "field": "safeToSend",
                        "label": "Safe to send"
                    },
                    {
                        "field": "deliverabilityScore",
                        "label": "Score"
                    },
                    {
                        "field": "result",
                        "label": "Raw result"
                    },
                    {
                        "field": "catchAll",
                        "label": "Catch-all"
                    },
                    {
                        "field": "roleName",
                        "label": "Role"
                    },
                    {
                        "field": "disposableProvider",
                        "label": "Disposable"
                    },
                    {
                        "field": "syntaxValid",
                        "label": "Syntax"
                    },
                    {
                        "field": "dnsValid",
                        "label": "DNS"
                    },
                    {
                        "field": "mxValid",
                        "label": "MX"
                    },
                    {
                        "field": "smtpValid",
                        "label": "SMTP"
                    },
                    {
                        "field": "checkedAt",
                        "label": "Checked at"
                    }
                ]
            }
        },
        "sendable": {
            "title": "Safe to send",
            "transformation": {
                "fields": [
                    "email",
                    "deliverabilityScore",
                    "result",
                    "checkedAt"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    {
                        "field": "email",
                        "label": "Email"
                    },
                    {
                        "field": "deliverabilityScore",
                        "label": "Score"
                    },
                    {
                        "field": "result",
                        "label": "Raw result"
                    },
                    {
                        "field": "checkedAt",
                        "label": "Checked at"
                    }
                ]
            }
        }
    }
}