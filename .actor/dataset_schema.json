{
    "actorSpecification": 1,
    "title": "Email Verifier dataset",
    "description": "One item per validated email. Mirrors the Verimailx /bulk-validate response, reshaped for the actor's three-state overall verdict.",
    "fields": {
        "type": "object",
        "required": ["email", "overall", "result", "syntax", "mx", "smtp", "checkedAt"],
        "properties": {
            "email":                { "type": "string",  "title": "Email" },
            "overall":              { "type": "string",  "title": "Overall",     "description": "Actor verdict: valid | invalid | unknown | error", "enum": ["valid", "invalid", "unknown", "error"] },
            "result":               { "type": "string",  "title": "Verimailx",   "description": "Raw Verimailx verdict: valid | invalid | risky | unknown", "enum": ["valid", "invalid", "risky", "unknown"] },
            "deliverabilityScore":  { "type": ["integer", "null"], "title": "Score", "description": "Verimailx deliverability score (0-100), or null if unavailable" },
            "syntax": {
                "type": "object",
                "title": "Syntax",
                "properties": {
                    "passed": { "type": "boolean", "title": "Passed" }
                }
            },
            "mx": {
                "type": "object",
                "title": "MX",
                "properties": {
                    "passed":  { "type": "boolean",            "title": "Passed" },
                    "domain":  { "type": "string",             "title": "Domain" },
                    "records": {
                        "type": "array",
                        "title": "MX records",
                        "items": {
                            "type": "object",
                            "properties": {
                                "exchange": { "type": ["string", "null"], "title": "Exchange" },
                                "priority": { "type": ["integer", "null"], "title": "Priority" }
                            }
                        }
                    }
                }
            },
            "smtp": {
                "type": "object",
                "title": "SMTP",
                "properties": {
                    "passed":   { "type": "boolean", "title": "Passed" },
                    "rejected": { "type": "boolean", "title": "Rejected" }
                }
            },
            "flags": {
                "type": "object",
                "title": "Flags",
                "properties": {
                    "dnsValid":  { "type": "boolean", "title": "DNS valid" },
                    "disposable":{ "type": "boolean", "title": "Disposable" },
                    "roleBased": { "type": "boolean", "title": "Role-based" }
                }
            },
            "error":     { "type": ["string", "null"], "title": "Error" },
            "checkedAt": { "type": "string",  "title": "Checked at" }
        }
    },
    "views": {
        "overview": {
            "title": "Verification results",
            "transformation": {
                "fields": ["email", "overall", "result", "deliverabilityScore", "syntax.passed", "mx.passed", "smtp.passed", "flags.disposable", "flags.roleBased", "checkedAt"]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "field": "email",               "label": "Email" },
                    { "field": "overall",             "label": "Overall" },
                    { "field": "result",              "label": "Verimailx" },
                    { "field": "deliverabilityScore", "label": "Score" },
                    { "field": "syntax.passed",       "label": "Syntax" },
                    { "field": "mx.passed",           "label": "MX" },
                    { "field": "smtp.passed",         "label": "SMTP" },
                    { "field": "flags.disposable",    "label": "Disposable" },
                    { "field": "flags.roleBased",     "label": "Role-based" }
                ]
            }
        }
    }
}
