{
    "actorSpecification": 1,
    "title": "Email Verifier dataset",
    "description": "One item per validated email. Mirrors the Verimailx /bulk-validate response, reshaped for the actor's three-state overall verdict. In syntax-only mode (no API key), mx/smtp/flags fields are null because those checks were not performed.",
    "fields": {
        "type": "object",
        "required": [
            "email",
            "overall",
            "result",
            "validationMode",
            "syntax",
            "mx",
            "smtp",
            "checkedAt"
        ],
        "properties": {
            "email": {
                "type": "string",
                "title": "Email"
            },
            "overall": {
                "type": "string",
                "title": "Overall",
                "description": "Actor verdict: valid | invalid | risky | unknown | error",
                "enum": [
                    "valid",
                    "invalid",
                    "risky",
                    "unknown",
                    "error"
                ]
            },
            "result": {
                "type": "string",
                "title": "Verimailx",
                "description": "Raw Verimailx verdict, passed through unchanged (valid, invalid, catch_all, unknown, ...)"
            },
            "deliverabilityScore": {
                "type": [
                    "integer",
                    "null"
                ],
                "title": "Score",
                "description": "Verimailx deliverability score (0-100), or null if unavailable"
            },
            "validationMode": {
                "type": "string",
                "title": "Mode",
                "description": "Validation depth: 'full' = Verimailx API call made, 'syntax-only' = local RFC syntax check only (no API key configured)",
                "enum": [
                    "full",
                    "syntax-only"
                ]
            },
            "syntax": {
                "type": "object",
                "title": "Syntax",
                "properties": {
                    "passed": {
                        "type": "boolean",
                        "title": "Passed"
                    }
                }
            },
            "mx": {
                "type": "object",
                "title": "MX",
                "properties": {
                    "passed": {
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "title": "Passed"
                    },
                    "domain": {
                        "type": "string",
                        "title": "Domain"
                    },
                    "records": {
                        "type": "array",
                        "title": "MX records",
                        "items": {
                            "type": "object",
                            "properties": {
                                "exchange": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "title": "Exchange"
                                },
                                "priority": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ],
                                    "title": "Priority"
                                }
                            }
                        }
                    }
                }
            },
            "smtp": {
                "type": "object",
                "title": "SMTP",
                "properties": {
                    "passed": {
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "title": "Passed"
                    },
                    "rejected": {
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "title": "Rejected"
                    }
                }
            },
            "flags": {
                "type": "object",
                "title": "Flags",
                "properties": {
                    "dnsValid": {
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "title": "DNS valid"
                    },
                    "disposable": {
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "title": "Disposable"
                    },
                    "roleBased": {
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "title": "Role-based"
                    },
                    "catchAll": {
                        "type": [
                            "boolean",
                            "null"
                        ],
                        "title": "Catch-all"
                    }
                }
            },
            "error": {
                "type": [
                    "string",
                    "null"
                ],
                "title": "Error"
            },
            "checkedAt": {
                "type": "string",
                "title": "Checked at"
            },
            "raw": {
                "type": "object",
                "title": "Raw row",
                "description": "The results-file row exactly as returned, so no column is lost if it is named unexpectedly."
            }
        }
    },
    "views": {
        "overview": {
            "title": "Verification results",
            "transformation": {
                "fields": [
                    "email",
                    "overall",
                    "result",
                    "deliverabilityScore",
                    "validationMode",
                    "syntax.passed",
                    "mx.passed",
                    "smtp.passed",
                    "flags.disposable",
                    "flags.roleBased",
                    "checkedAt"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    {
                        "field": "email",
                        "label": "Email"
                    },
                    {
                        "field": "overall",
                        "label": "Overall"
                    },
                    {
                        "field": "result",
                        "label": "Verimailx"
                    },
                    {
                        "field": "deliverabilityScore",
                        "label": "Score"
                    },
                    {
                        "field": "validationMode",
                        "label": "Mode"
                    },
                    {
                        "field": "syntax.passed",
                        "label": "Syntax"
                    },
                    {
                        "field": "mx.passed",
                        "label": "MX"
                    },
                    {
                        "field": "smtp.passed",
                        "label": "SMTP"
                    },
                    {
                        "field": "flags.disposable",
                        "label": "Disposable"
                    },
                    {
                        "field": "flags.roleBased",
                        "label": "Role-based"
                    }
                ]
            }
        }
    }
}